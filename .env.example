# Flask backend local API (used by Vite proxy via /api/*)
# No need to change this for local frontend usage.

# Remote RAG endpoint configuration (choose one approach)
# 1) Full URL (highest priority)
# RAG_API_URL=https://your-rag-host.com/api/v1/integration

# 2) Base URL + path
RAG_API_BASE_URL=http://127.0.0.1:8000
RAG_INTEGRATION_PATH=/api/v1/integration

# Optional bearer token sent to remote RAG
# RAG_API_TOKEN=replace-with-your-token

# Integration timeout in seconds
RAG_TIMEOUT_SECONDS=90

# Number of context chunks requested from remote RAG
RAG_TOP_K=5

# API key for News API (from newsapi.org)
# NEWS_API_KEY=your-api-key-here

# true  = if remote RAG fails, return local fallback answer
# false = if remote RAG fails, return HTTP 502 with explicit error
RAG_ALLOW_LOCAL_FALLBACK=false

# Optional auth for THIS Flask endpoint /api/v1/integration
# (usually keep disabled unless another service calls this backend directly)
INTEGRATION_AUTH_ENABLED=false
# INTEGRATION_BEARER_TOKEN=replace-with-internal-token

# --- RAG SYSTEM AI KEYS ---
# GROQ_API_KEY=gsk_your_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# OPENAI_API_KEY=sk-proj-your-key-here
# OPENAI_MODEL=gpt-4o-mini

# OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434

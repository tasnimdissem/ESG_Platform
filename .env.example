# Example environment for ESG Platform
# Copy this file to .env and fill in real values.

# -----------------------------------------------------------------------------
# PostgreSQL / Auth
# -----------------------------------------------------------------------------
POSTGRES_USER=esg_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=esg_db

# Local run: use localhost:5433
# Docker Compose backend: the service uses postgres:5432 internally
DATABASE_URL=postgresql://esg_user:change-me@localhost:5433/esg_db
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# -----------------------------------------------------------------------------
# Backend / RAG
# -----------------------------------------------------------------------------
RAG_API_BASE_URL=http://127.0.0.1:8000
RAG_INTEGRATION_PATH=/api/v1/query
RAG_API_URL=
RAG_API_TOKEN=
RAG_TIMEOUT_SECONDS=90
RAG_TOP_K=5
RAG_ALLOW_LOCAL_FALLBACK=false

# -----------------------------------------------------------------------------
# Optional backend auth for /api/v1/integration
# -----------------------------------------------------------------------------
INTEGRATION_AUTH_ENABLED=false
INTEGRATION_BEARER_TOKEN=

# -----------------------------------------------------------------------------
# News API
# -----------------------------------------------------------------------------
NEWS_API_KEY=

# -----------------------------------------------------------------------------
# SMTP / Email service
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=no-reply@esg-platform.local
EMAIL_FROM_NAME=ESG Platform
EMAIL_RESET_LINK_BASE_URL=http://localhost:5173/reset-password

# -----------------------------------------------------------------------------
# Optional AI keys used by the RAG system
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

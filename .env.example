# Example environment for ESG Platform
# Copy this file to .env and fill in real values.

# -----------------------------------------------------------------------------
# PostgreSQL / Auth
# -----------------------------------------------------------------------------
POSTGRES_USER=esg_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=esg_db

# Local run: use localhost:5433
# Docker Compose backend: the service uses postgres:5432 internally
DATABASE_URL=postgresql://esg_user:change-me@localhost:5433/esg_db
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# -----------------------------------------------------------------------------
# Backend / RAG
# -----------------------------------------------------------------------------
# RAG configuration
# Adjust these values as needed for your RAG service.
RAG_API_BASE_URL=http://127.0.0.1:8000   # Base URL of the RAG backend
RAG_INTEGRATION_PATH=/api/v1/query      # Path for query endpoint
RAG_API_URL=                             # Full URL (optional, overrides base+path)
RAG_API_TOKEN=                           # Authentication token for RAG service
RAG_TIMEOUT_SECONDS=90                  # Request timeout in seconds
RAG_TOP_K=5                              # Number of results to return per query
RAG_ALLOW_LOCAL_FALLBACK=false          # Set true to fallback to local knowledge base

# -----------------------------------------------------------------------------
# Flask / Debug settings (set to production to disable auto‑reloader and debugger)
FLASK_ENV=development                    # Change to 'production' for prod mode
FLASK_DEBUG=0                            # 1 to enable debugger, 0 to disable

# -----------------------------------------------------------------------------
# Hugging Face token (already added to .env, keep here for reference)
HF_TOKEN=your_hf_token_here

# -----------------------------------------------------------------------------
# SMTP / Email service (recommended: direct Gmail SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tassou.dissem@gmail.com
SMTP_PASSWORD=sawx aazz cmek yria
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=tassou.dissem@gmail.com
EMAIL_FROM_NAME=ESG Platform
EMAIL_RESET_LINK_BASE_URL=http://localhost:5173/reset-password

# -----------------------------------------------------------------------------
# Optional Postfix relay mode (only if you explicitly enable the postfix profile)
# docker compose --profile postfix up
# -----------------------------------------------------------------------------
# Postfix container credentials used to generate /etc/postfix/sasl_passwd
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_google_app_password

# Optional Postfix tuning
POSTFIX_MYHOSTNAME=postfix.local
POSTFIX_MYNETWORKS=127.0.0.0/8 [::1]/128 172.16.0.0/12
POSTFIX_RELAY_HOST=[smtp.gmail.com]:587

# Flask mail settings pointed at the local Postfix relay
MAIL_SERVER=postfix
MAIL_PORT=25
MAIL_USE_TLS=false
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=

# -----------------------------------------------------------------------------
# Optional backend auth for /api/v1/integration
# -----------------------------------------------------------------------------
INTEGRATION_AUTH_ENABLED=false
INTEGRATION_BEARER_TOKEN=

# -----------------------------------------------------------------------------
# News API
# -----------------------------------------------------------------------------
NEWS_API_KEY=


# -----------------------------------------------------------------------------
# Optional AI keys used by the RAG system
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434
